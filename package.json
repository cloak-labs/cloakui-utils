{
  "name": "@cloakui/utils",
  "version": "0.1.4",
  "description": "Shared utilities for all CloakUI component packages.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "dev": "tsc -p tsconfig.json -w --preserveWatchOutput",
    "build": "npm run build-ts",
    "build-ts": "tsc -p tsconfig.json",
    "clean": "rm -rf .turbo && rm -rf dist",
    "clean:modules": "rm -rf node_modules",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cloak-labs/cloakui-utils.git"
  },
  "keywords": [
    "ui",
    "utils",
    "utilities",
    "cloakui",
    "ui kit",
    "ui library"
  ],
  "author": "Kaelan Smith",
  "license": "LGPL-3.0-only",
  "bugs": {
    "url": "https://github.com/cloak-labs/cloakui-utils/issues"
  },
  "homepage": "https://github.com/cloak-labs/cloakui-utils#readme",
  "devDependencies": {
    "@types/node": "^18.19.130",
    "typescript": "7.0.2",
    "oxfmt": "0.71.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
